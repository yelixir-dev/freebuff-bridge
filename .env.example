# Freebuff upstream
FREEBUFF_API_BASE=https://www.codebuff.com
FREEBUFF_CLI_VERSION=0.0.149
FREEBUFF_DEFAULT_MODEL=deepseek/deepseek-v4-flash
# Dashboard-managed bridge settings and credentials
FREEBUFF_CONFIG_PATH=
# Optional import source; defaults to the current Freebuff CLI login file
FREEBUFF_CREDENTIALS_PATH=
# Comma-separated extra auth tokens, in addition to ~/.config/manicode/credentials.json
FREEBUFF_AUTH_TOKENS=
FREEBUFF_ROUTING_POLICY=thin_long
FREEBUFF_MAX_CONCURRENT=0
FREEBUFF_CREDENTIAL_COOLDOWN_MS=60000
FREEBUFF_TIMEOUT_MS=600000

# Bridge server
HOST=127.0.0.1
PORT=9993
BRIDGE_API_KEY=
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
CORS_ORIGIN=
